---
import { projects, projectHref, projectImage } from '../data/projects';
import { url } from '../lib/url';
---

<div class="project-cloud">
  <h1 class="cloud">
    <span class="visually-hidden">Select projects</span>
    {
      projects.map((p, i) => {
        const r = p.reveal ?? {};
        return (
          <>
            {i > 0 && (
              <span class="dot" aria-hidden="true">
                •
              </span>
            )}
            <a
              class="cloud-link"
              href={url(projectHref(p))}
              style={`--w:${r.w ?? 320}px; --r:${r.rotate ?? 0}deg; --dx:${r.dx ?? 0}px; --dy:${r.dy ?? 0}px;`}
            >
              {/* Sits inside the link, centred on it, painted underneath the label. */}
              <img
                class="reveal"
                src={url(projectImage(p))}
                alt=""
                aria-hidden="true"
                loading="lazy"
                decoding="async"
                width="344"
                height="430"
              />
              <span class="label">{p.title}</span>
            </a>
          </>
        );
      })
    }
  </h1>
</div>

<style>
  .project-cloud {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 18vh var(--gutter) 8vh;
  }

  .cloud {
    position: relative;
    z-index: 20;
    margin: 0;
    max-width: 1100px;
    text-align: center;
    text-wrap: balance;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(1.6rem, 4.85vw, 4rem);
    line-height: 1.3;
    letter-spacing: 0.01em;
    color: var(--overlay);
  }

  /* inline-block, not inline: an inline link fragments across lines and its
     abspos child would resolve `left: 50%` against the whole <h1> instead of
     the word. This keeps each name one unbroken box to centre the image on. */
  .cloud-link {
    position: relative;
    display: inline-block;
    transition: opacity var(--dur) var(--ease);
  }

  /* The label is lifted above the thumbnail so the name stays readable. */
  .label {
    position: relative;
    z-index: 1;
  }

  .reveal {
    position: absolute;
    z-index: 0;
    left: 50%;
    top: 50%;
    width: min(var(--w), 42vw);
    height: auto;
    pointer-events: none;
    opacity: 0;
    transform: translate(calc(-50% + var(--dx)), calc(-50% + var(--dy))) scale(0.96)
      rotate(var(--r));
    transition:
      opacity var(--dur) var(--ease),
      transform var(--dur) var(--ease);
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.22);
    will-change: opacity, transform;
  }

  .cloud-link:hover .reveal,
  .cloud-link:focus-visible .reveal {
    opacity: 1;
    transform: translate(calc(-50% + var(--dx)), calc(-50% + var(--dy))) scale(1)
      rotate(var(--r));
  }

  /* Dim the rest of the list so the hovered name reads as selected. */
  .cloud:has(.cloud-link:hover) .cloud-link:not(:hover),
  .cloud:has(.cloud-link:hover) .dot {
    opacity: 0.45;
  }

  .dot {
    margin: 0 0.35em;
    transition: opacity var(--dur) var(--ease);
  }

  /* Touch devices never fire hover — don't download thumbnails they can't show. */
  @media (hover: none) {
    .reveal {
      display: none;
    }
  }
</style>
