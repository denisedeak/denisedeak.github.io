---
import { footerLinks, site } from '../data/site';
import { url } from '../lib/url';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <ul class="footer-links">
    {
      footerLinks.map((item) => (
        <li>
          <a
            href={url(item.href)}
            {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>

  <p class="colophon">
    <span>&copy; {year} {site.name}</span>
    <span>Open to worldwide work.</span>
  </p>
</footer>

<style>
  .site-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    padding: clamp(1rem, 2vw, 1.5rem) clamp(1rem, 2.5vw, 2rem);
    background: var(--butter);
    color: var(--ink);
  }

  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }

  .footer-links a {
    font-family: var(--font-display);
    font-size: clamp(0.62rem, 0.85vw, 0.8rem);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--cocoa);
    transition: opacity var(--dur) var(--ease);
  }

  .footer-links a:hover {
    opacity: 0.5;
  }

  .colophon {
    display: grid;
    gap: 0.35rem;
    margin: 0;
    text-align: right;
    font-family: var(--font-display);
    font-size: clamp(0.62rem, 0.85vw, 0.8rem);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--ink-60);
  }

  @media (max-width: 640px) {
    .colophon {
      text-align: left;
    }
  }
</style>
