---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';

const disciplines = [
  {
    name: 'BRAND / VISUAL IDENTITY',
    skills: [
      'Brand Identity',
      'Visual Identity Systems',
      'Art Direction',
      'Creative Direction',
      'Campaign Design',
      'Typography',
      'Logo Design',
      'Brand Guidelines',
      'Editorial Design',
      'Digital Design',
    ],
  },
  {
    name: '3D & 2D MOTION',
    skills: [
      'Motion Design',
      '2D Animation',
      '3D Animation',
      '3D Design',
      'CGI',
      'Motion Identity',
      'Kinetic Typography',
      'Product Animation',
    ],
  },
  {
    name: 'SOCIAL',
    skills: [
      'Social Campaigns',
      'Social Content',
      'Video Editing',
      'Carousels',
      'AR Experiences',
      'Digital Campaigns',
      'Content Design',
    ],
  },
];
---

<Base title="about / contact">
  <section class="about-page" aria-label="About Nise Studio">
    <div class="about-panel">
      <figure class="portrait">
        <img src="/images/denise-portrait.jpg" alt="Denise in front of an orange doorway" />
      </figure>

      <div class="about-copy" id="contact">
        <p>
          Hi, I’m Denise, a multidisciplinary designer with a soft spot for big ideas and
          beautiful details.
        </p>
        <p>
          I work across brand, motion, 3D and digital — bringing ideas to life through
          thoughtful design, strong visual storytelling and a little bit of play. I’m drawn to
          thoughtful ideas with character and a point of view.
        </p>

        <a class="cv-link" href={url('/documents/denise-deak-2026-cv.pdf')} download>
          DOWNLOAD CV
        </a>

        <div class="accordions">
          {
            disciplines.map((discipline) => (
              <details class="discipline">
                <summary>
                  <span>{discipline.name}</span>
                  <span class="plus" aria-hidden="true">+</span>
                </summary>
                <div class="skills">
                  <ul>
                    {discipline.skills.map((skill) => <li>{skill}</li>)}
                  </ul>
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  :global(body) {
    background: var(--blush);
  }

  :global(.site-header .wordmark) {
    color: var(--vermilion);
  }

  :global(.site-footer) {
    background: var(--blush);
  }

  .about-page {
    padding: clamp(7.5rem, 13vw, 10rem) var(--gutter) clamp(3rem, 7vw, 7rem);
  }

  .about-panel {
    max-width: 1280px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(16rem, 0.8fr) minmax(0, 1.2fr);
    background: var(--blush);
    color: var(--cocoa);
  }

  .portrait {
    margin: 0;
    align-self: start;
    height: clamp(34rem, 49vw, 52rem);
  }

  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 53% center;
  }

  .about-copy {
    padding: clamp(1.5rem, 4vw, 4rem);
    align-self: start;
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.55vw, 1.35rem);
    line-height: 1.38;
  }

  .about-copy p {
    max-width: 46rem;
    margin: 0;
  }

  .about-copy p + p {
    margin-top: 1.65em;
  }

  .cv-link {
    display: inline-block;
    margin-top: 2.25rem;
    color: var(--cocoa);
    font-size: 0.78em;
    font-weight: 600;
    letter-spacing: 0.035em;
    text-transform: uppercase;
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.15em;
  }

  .accordions {
    margin-top: clamp(2.6rem, 5vw, 4.25rem);
    border-top: 2px solid var(--vermilion);
  }

  .discipline {
    border-bottom: 2px solid var(--vermilion);
  }

  .discipline summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: clamp(0.9rem, 1.7vw, 1.25rem) 0;
    cursor: pointer;
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 2.85vw, 2.7rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1;
    color: var(--vermilion);
    list-style: none;
  }

  .discipline summary::-webkit-details-marker {
    display: none;
  }

  .plus {
    flex: 0 0 auto;
    font-family: var(--font-display);
    font-size: 1.25em;
    font-weight: 300;
    line-height: 0.7;
    transition: transform var(--dur) var(--ease);
  }

  .discipline[open] .plus {
    transform: rotate(45deg);
  }

  .skills {
    overflow: hidden;
  }

  .discipline[open] .skills ul {
    animation: skill-list-reveal 360ms ease-out 100ms both;
  }

  .skills ul {
    list-style: none;
    columns: 2;
    column-gap: 2rem;
    margin: 0;
    padding: 0 0 1.5rem;
    font-size: clamp(0.86rem, 1.1vw, 1rem);
    line-height: 1.45;
  }

  .discipline li {
    break-inside: avoid;
  }

  @keyframes skill-list-reveal {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  @media (max-width: 760px) {
    .about-page {
      padding: 9.2rem 0 3rem;
    }

    .about-panel {
      grid-template-columns: 1fr;
    }

    .portrait img {
      max-height: 38rem;
      object-position: 54% 55%;
    }

    .portrait {
      height: clamp(28rem, 120vw, 38rem);
    }

    .about-copy {
      padding: 1.5rem 1rem 2.25rem;
    }

    .skills ul {
      columns: 1;
    }
  }
</style>
