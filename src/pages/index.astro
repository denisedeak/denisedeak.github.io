---
import Base from '../layouts/Base.astro';
import ProjectCloud from '../components/ProjectCloud.astro';
import { site } from '../data/site';
import { url } from '../lib/url';
---

<Base title="select projects" overlayHeader>
  <section class="hero">
    <img
      class="hero-media"
      src={url(`/images/${site.heroImage}`)}
      alt=""
      width="1600"
      height="1000"
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero-scrim" aria-hidden="true"></div>
    <ProjectCloud />
  </section>
</Base>

<style>
  .hero {
    position: relative;
    min-height: var(--hero-min);
    overflow: hidden;
    isolation: isolate;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
    z-index: 0;
  }

  /* A soft top-down scrim keeps the white wordmark legible over any photo. */
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.28) 0%,
      rgba(0, 0, 0, 0.06) 32%,
      rgba(0, 0, 0, 0.1) 100%
    );
  }
</style>
