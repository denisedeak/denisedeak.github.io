---
import Base from '../layouts/Base.astro';
import ProjectCloud from '../components/ProjectCloud.astro';
import { site } from '../data/site';
import { url } from '../lib/url';
---

<Base title="select projects" overlayHeader landing>
  <section class="landing" aria-label="Nise Studio selected projects">
    <div class="image-stage">
      <img
        class="hero-media"
        src={url(`/images/${site.heroImage}`)}
        alt=""
        width="1920"
        height="1080"
        fetchpriority="high"
        decoding="async"
      />
      <canvas class="hero-liquid" aria-hidden="true"></canvas>
      <div class="hero-wash" aria-hidden="true"></div>
      <ProjectCloud />
    </div>

  </section>
</Base>

<style>
  .landing {
    width: 100%;
    height: 100%;
    min-height: 0;
    margin: 0;
    display: grid;
  }

  .image-stage {
    position: relative;
    min-height: 0;
    overflow: hidden;
    isolation: isolate;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
    transition: opacity 180ms linear;
  }

  .hero-liquid {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    transition: opacity 180ms linear;
  }

  .image-stage.is-liquid-ready .hero-media {
    opacity: 0;
  }

  .image-stage.is-liquid-ready .hero-liquid {
    opacity: 1;
  }

  .hero-wash {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(
        ellipse 58% 46% at 50% 53%,
        rgba(52, 25, 14, 0.4) 0%,
        rgba(89, 52, 29, 0.25) 46%,
        rgba(89, 52, 29, 0) 100%
      ),
      linear-gradient(180deg, rgba(37, 15, 8, 0.1), rgba(89, 52, 29, 0.05) 42%, rgba(37, 15, 8, 0.14));
  }

  @media (max-width: 760px) {
    .landing {
      width: 100%;
      height: 100%;
      min-height: 0;
      margin: 0;
    }

    .image-stage {
      min-height: 31rem;
    }

    .hero-media {
      object-position: 48% center;
    }

    /* A visible, low-cost fallback for browsers that do not expose WebGL. */
    .image-stage:not(.is-liquid-ready) .hero-media {
      animation: mobile-background-drift 14s ease-in-out infinite alternate;
      transform: scale(1.045);
    }

    @media (prefers-reduced-motion: reduce) {
      .image-stage:not(.is-liquid-ready) .hero-media {
        animation: none;
        transform: none;
      }
    }

    @keyframes mobile-background-drift {
      from { object-position: 42% 44%; }
      to { object-position: 58% 56%; }
    }

  }
</style>

<script>
  const stage = document.querySelector<HTMLElement>('.image-stage');
  const image = stage?.querySelector<HTMLImageElement>('.hero-media');
  const canvas = stage?.querySelector<HTMLCanvasElement>('.hero-liquid');
  const hasFinePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  // Use the responsive layout breakpoint rather than input type so browser mobile
  // previews receive the same ambient motion as physical phones.
  const useAutonomousLiquid = window.matchMedia('(max-width: 760px)').matches;
  const useIdleDesktopLiquid = hasFinePointer && !useAutonomousLiquid;
  const canUseLiquid = (hasFinePointer || useAutonomousLiquid) &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (stage && image && canvas && canUseLiquid) {
    const gl = canvas.getContext('webgl', {
      alpha: false,
      antialias: false,
      powerPreference: 'low-power',
    });

    if (gl) {
      const vertexSource = `
        attribute vec2 aPosition;
        varying vec2 vUv;
        void main() {
          vUv = (aPosition + 1.0) * 0.5;
          gl_Position = vec4(aPosition, 0.0, 1.0);
        }
      `;
      const fragmentSource = `
        precision mediump float;
        varying vec2 vUv;
        uniform sampler2D uImage;
        uniform vec2 uResolution;
        uniform vec2 uImageSize;
        uniform vec2 uPointer;
        uniform float uTime;
        uniform float uEnergy;
        uniform float uAmbient;

        vec2 coverUv(vec2 uv) {
          float canvasRatio = uResolution.x / uResolution.y;
          float imageRatio = uImageSize.x / uImageSize.y;
          if (canvasRatio > imageRatio) {
            uv.y = (uv.y - 0.5) * imageRatio / canvasRatio + 0.5;
          } else {
            uv.x = (uv.x - 0.5) * canvasRatio / imageRatio + 0.5;
          }
          return clamp(uv, 0.001, 0.999);
        }

        void main() {
          vec2 delta = vUv - uPointer;
          delta.x *= uResolution.x / uResolution.y;
          float distanceToPointer = length(delta);
          vec2 direction = normalize(delta + vec2(0.0001));
          float falloff = exp(-distanceToPointer * distanceToPointer * 16.0);
          float rippleFrequency = mix(48.0, 44.0, uAmbient);
          float rippleStrength = mix(0.013, 0.022, uAmbient);
          float ripple = sin(distanceToPointer * rippleFrequency - uTime * 7.0) * rippleStrength;
          vec2 liquidUv = vUv + direction * ripple * falloff * uEnergy;

          // On the compact layout this becomes a full-frame liquid current,
          // while desktop retains the cursor's more localised ripple.
          vec2 ambientFlow = vec2(
            sin(vUv.y * 12.0 + uTime * 1.1) + sin(vUv.x * 7.0 - uTime * 0.8) * 0.5,
            cos(vUv.x * 10.0 - uTime * 0.9) + cos(vUv.y * 6.0 + uTime * 0.6) * 0.5
          ) * 0.018 * uAmbient;
          liquidUv += ambientFlow;
          gl_FragColor = texture2D(uImage, coverUv(liquidUv));
        }
      `;

      const makeShader = (type: number, source: string) => {
        const shader = gl.createShader(type)!;
        gl.shaderSource(shader, source);
        gl.compileShader(shader);
        return gl.getShaderParameter(shader, gl.COMPILE_STATUS) ? shader : null;
      };
      const vertex = makeShader(gl.VERTEX_SHADER, vertexSource);
      const fragment = makeShader(gl.FRAGMENT_SHADER, fragmentSource);

      if (vertex && fragment) {
        const program = gl.createProgram()!;
        gl.attachShader(program, vertex);
        gl.attachShader(program, fragment);
        gl.linkProgram(program);

        if (gl.getProgramParameter(program, gl.LINK_STATUS)) {
          const positions = gl.createBuffer();
          gl.bindBuffer(gl.ARRAY_BUFFER, positions);
          gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);

          const position = gl.getAttribLocation(program, 'aPosition');
          const resolution = gl.getUniformLocation(program, 'uResolution');
          const imageSize = gl.getUniformLocation(program, 'uImageSize');
          const pointer = gl.getUniformLocation(program, 'uPointer');
          const time = gl.getUniformLocation(program, 'uTime');
          const energyUniform = gl.getUniformLocation(program, 'uEnergy');
          const ambientUniform = gl.getUniformLocation(program, 'uAmbient');
          const texture = gl.createTexture();
          let pointerX = 0.5;
          let pointerY = 0.5;
          let targetX = 0.5;
          let targetY = 0.5;
          let energy = 0;
          let lastFrame = 0;
          let lastRender = 0;
          let cursorPriorityUntil = 0;
          let ambientAmount = useAutonomousLiquid ? 1 : (useIdleDesktopLiquid ? 0.38 : 0);
          let isAnimating = false;
          let animationFrame: number | undefined;

          const resize = () => {
            const bounds = stage.getBoundingClientRect();
            const scale = Math.min(window.devicePixelRatio || 1, 1.5);
            canvas.width = Math.round(bounds.width * scale);
            canvas.height = Math.round(bounds.height * scale);
            gl.viewport(0, 0, canvas.width, canvas.height);
          };

          const draw = (now: number) => {
            gl.useProgram(program);
            gl.bindBuffer(gl.ARRAY_BUFFER, positions);
            gl.enableVertexAttribArray(position);
            gl.vertexAttribPointer(position, 2, gl.FLOAT, false, 0, 0);
            gl.uniform2f(resolution, canvas.width, canvas.height);
            gl.uniform2f(imageSize, image.naturalWidth, image.naturalHeight);
            gl.uniform2f(pointer, pointerX, pointerY);
            gl.uniform1f(time, now * 0.001);
            gl.uniform1f(energyUniform, energy);
            gl.uniform1f(ambientUniform, ambientAmount);
            gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
          };

          const settle = (now: number) => {
            const elapsed = lastFrame ? Math.min(now - lastFrame, 50) : 16;
            lastFrame = now;
            const cursorHasPriority = now < cursorPriorityUntil;
            const desiredAmbient = useAutonomousLiquid ? 1 : (useIdleDesktopLiquid && !cursorHasPriority ? 0.38 : 0);
            const ambientFollow = 1 - Math.exp(-elapsed * 0.008);
            ambientAmount += (desiredAmbient - ambientAmount) * ambientFollow;

            if (useAutonomousLiquid) {
              const seconds = now * 0.001;
              targetX = 0.5 + Math.sin(seconds * 0.19) * 0.32 + Math.sin(seconds * 0.43 + 1.2) * 0.12;
              targetY = 0.5 + Math.cos(seconds * 0.15 + 0.45) * 0.3 + Math.sin(seconds * 0.31) * 0.12;
              energy = 1.18 + Math.sin(seconds * 0.42) * 0.1;
            } else if (useIdleDesktopLiquid && !cursorHasPriority) {
              const seconds = now * 0.001;
              targetX = 0.5 + Math.sin(seconds * 0.16) * 0.22 + Math.sin(seconds * 0.37 + 1.2) * 0.06;
              targetY = 0.5 + Math.cos(seconds * 0.13 + 0.45) * 0.17 + Math.sin(seconds * 0.29) * 0.05;
              energy = 0.42 + Math.sin(seconds * 0.35) * 0.05;
            }

            const follow = 1 - Math.exp(-elapsed * 0.05);
            pointerX += (targetX - pointerX) * follow;
            pointerY += (targetY - pointerY) * follow;
            if (!useAutonomousLiquid && (!useIdleDesktopLiquid || cursorHasPriority)) {
              energy *= Math.exp(-elapsed * 0.003);
            }

            // Ambient desktop motion is rendered at roughly 30fps; direct cursor
            // interaction remains at the browser's native refresh rate.
            const isIdleDesktopFrame = useIdleDesktopLiquid && !cursorHasPriority;
            if (isIdleDesktopFrame && lastRender && now - lastRender < 32) {
              animationFrame = requestAnimationFrame(settle);
              return;
            }

            draw(now);
            lastRender = now;

            if (useAutonomousLiquid || useIdleDesktopLiquid || energy > 0.008 || Math.hypot(targetX - pointerX, targetY - pointerY) > 0.0005) {
              animationFrame = requestAnimationFrame(settle);
            } else {
              energy = 0;
              draw(now);
              isAnimating = false;
              animationFrame = undefined;
            }
          };

          const beginSettling = () => {
            if (!isAnimating) {
              isAnimating = true;
              lastFrame = 0;
              lastRender = 0;
              animationFrame = requestAnimationFrame(settle);
            }
          };

          const uploadTexture = () => {
            gl.bindTexture(gl.TEXTURE_2D, texture);
            gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, true);
            gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
            gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
            gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
            gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
            gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, image);
            resize();
            draw(0);
            stage.classList.add('is-liquid-ready');
            if (useAutonomousLiquid || useIdleDesktopLiquid) beginSettling();
          };

          if (!useAutonomousLiquid) {
            stage.addEventListener('pointermove', (event) => {
              const bounds = stage.getBoundingClientRect();
              const nextX = (event.clientX - bounds.left) / bounds.width;
              const nextY = 1 - (event.clientY - bounds.top) / bounds.height;
              const distance = Math.hypot(nextX - targetX, nextY - targetY);
              // Every cursor movement renews the handoff. Once it stops, the
              // ambient current eases back in rather than leaving a static pause.
              cursorPriorityUntil = performance.now() + 380;
              targetX = nextX;
              targetY = nextY;
              energy = Math.min(1, Math.max(energy, 0.28) + distance * 3.2);
              beginSettling();
            });
            stage.addEventListener('pointerleave', () => {
              cursorPriorityUntil = 0;
              beginSettling();
            });
          }
          window.addEventListener('resize', () => {
            resize();
            draw(performance.now());
          });
          document.addEventListener('visibilitychange', () => {
            if (document.hidden && animationFrame) {
              cancelAnimationFrame(animationFrame);
              animationFrame = undefined;
              isAnimating = false;
            } else if (!document.hidden && (useAutonomousLiquid || useIdleDesktopLiquid)) {
              beginSettling();
            }
          });

          if (image.complete) uploadTexture();
          else image.addEventListener('load', uploadTexture, { once: true });
        }
      }
    }
  }
</script>
